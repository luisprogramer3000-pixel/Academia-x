# ==============================================================================
# MENTOR STUDIO GLOBAL — DOCUMENTACIÓN OFICIAL DE VARIABLES DE ENTORNO (PRODUCCIÓN & DEV)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP & ENTORNO DE EJECUCIÓN (PUBLIC & SERVER)
# ------------------------------------------------------------------------------
# [SERVER] [REQUIRED IN PRODUCTION] Entorno de ejecución: "development" | "production" | "test"
NODE_ENV="development"

# [PUBLIC] [REQUIRED IN PRODUCTION] URL pública principal de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [PUBLIC] [REQUIRED IN PRODUCTION] Dominio base para resolución multi-tenant por subdominio (ej. "mentorstudioglobal.com")
NEXT_PUBLIC_APP_HOST="localhost"

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL & PRISMA (SERVER - SECRETS)
# ------------------------------------------------------------------------------
# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] URL de conexión con PgBouncer (puerto 6543)
# IMPORTANTE (serverless: Vercel y similares): pooler en modo TRANSACCIÓN (6543), pgbouncer=true y connection_limit=1
# IMPORTANTE (VPS con proceso permanente: Hostinger): usar el mismo pooler PERO con connection_limit=10.
#   connection_limit=1 está pensado para funciones efímeras; en un servidor fijo serializa todas
#   las consultas y la aplicación se vuelve lentísima con varios usuarios a la vez.
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] URL de conexión directa para migraciones (puerto 5432)
DIRECT_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN & SESIONES JWT (SERVER - SECRET)
# ------------------------------------------------------------------------------
# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] Secreto para firmar tokens JWT (mínimo 32 caracteres)
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="your-32-character-minimum-production-jwt-secret-key-placeholder"

# ------------------------------------------------------------------------------
# 4. SUPABASE INTEGRATION (PUBLIC & SERVER)
# ------------------------------------------------------------------------------
# [PUBLIC] [REQUIRED IN PRODUCTION] URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"

# [PUBLIC] [REQUIRED IN PRODUCTION] Clave pública anónima de Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-placeholder"

# ------------------------------------------------------------------------------
# 5. PROVEEDOR DE IA & ADAPTADORES (SERVER - SECRETS)
# ------------------------------------------------------------------------------
# [SERVER] [OPTIONAL IN DEV] Proveedor activo: "openai" | "mock" (Por defecto "openai" en producción)
AI_PROVIDER="mock"

# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] API Key de OpenAI para el adaptador de producción
OPENAI_API_KEY="sk-proj-your-openai-production-api-key-placeholder"

# [SERVER] [OPTIONAL] Modelo de OpenAI a utilizar (por defecto "gpt-4o-mini")
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 6. STRIPE PAYMENTS & BILLING (PUBLIC & SERVER - SECRETS)
# ------------------------------------------------------------------------------
# [PUBLIC] [REQUIRED IN PRODUCTION] Clave pública de Stripe (pk_test_* en Dev, pk_live_* en Prod)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key-placeholder"

# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] Clave secreta de Stripe (sk_test_* en Dev, sk_live_* en Prod)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key-placeholder"

# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] Secreto de firma de Webhooks de Stripe (whsec_*)
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret-placeholder"

# [SERVER] [OPTIONAL IN DEV, REQUIRED IN PRODUCTION] Stripe Price IDs oficiales (6 precios: Mensual y Anual con 20% descuento)
STRIPE_PRICE_STARTER_MONTHLY="price_starter_monthly_placeholder"
STRIPE_PRICE_STARTER_YEARLY="price_starter_yearly_placeholder"
STRIPE_PRICE_PRO_MONTHLY="price_pro_monthly_placeholder"
STRIPE_PRICE_PRO_YEARLY="price_pro_yearly_placeholder"
STRIPE_PRICE_ACADEMY_MONTHLY="price_academy_monthly_placeholder"
STRIPE_PRICE_ACADEMY_YEARLY="price_academy_yearly_placeholder"

# ------------------------------------------------------------------------------
# 6b. EMAILS TRANSACCIONALES (RESEND)
# ------------------------------------------------------------------------------
# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] API Key de Resend (https://resend.com) para invitaciones, bienvenida y recuperación de contraseña
RESEND_API_KEY="re_your-resend-api-key-placeholder"

# [SERVER] [REQUIRED IN PRODUCTION] Remitente verificado en Resend
EMAIL_FROM="Mentor Studio Global <no-reply@mentorstudioglobal.com>"

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & UPSTASH REDIS (SERVER - SECRETS)
# ------------------------------------------------------------------------------
# [SERVER] [OPTIONAL IN DEV, REQUIRED IN PRODUCTION] Proveedor de Rate Limiting: "upstash" | "memory"
RATE_LIMIT_PROVIDER="memory"

# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] Endpoint REST de Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"

# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] Token REST de Upstash Redis
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token-placeholder"

# ------------------------------------------------------------------------------
# 8. CRON & JOBS PROGRAMADOS (SERVER - SECRET)
# ------------------------------------------------------------------------------
# [SERVER] [SECRET] [REQUIRED IN PRODUCTION] Secreto para autenticar peticiones cron en /api/cron/*
# En VPS lo consume deploy/cron-ai-credit-reset.sh (el cron de vercel.json NO se ejecuta fuera de Vercel)
CRON_SECRET="your-cron-secret-authorization-token-placeholder"

# ------------------------------------------------------------------------------
# 8b. SOPORTE AL CLIENTE (SERVER)
# ------------------------------------------------------------------------------
# [SERVER] [REQUIRED IN PRODUCTION] Canales reales del Soporte Prioritario VIP (plan Academy Executive).
# Si quedan vacíos, la página de soporte NO muestra datos de contacto inventados:
# avisa al propietario de que faltan por configurar.
SUPPORT_EMAIL="soporte@mentorstudioglobal.com"

# [SERVER] [OPTIONAL] WhatsApp con prefijo de país, solo dígitos (formato wa.me). Vacío = no se muestra la tarjeta.
SUPPORT_WHATSAPP="34600000000"

# [SERVER] [OPTIONAL] Horas de respuesta prometidas en la página de soporte (por defecto 24)
SUPPORT_RESPONSE_HOURS="24"

# ------------------------------------------------------------------------------
# 9. ALMACENAMIENTO DE ARCHIVOS SUBIDOS (SERVER)
# ------------------------------------------------------------------------------
# [SERVER] [OPTIONAL] Carpeta física donde se guardan logos y materiales.
# Por defecto: <proyecto>/public/uploads
# En VPS apuntarla FUERA del proyecto para que un redespliegue no borre los archivos
# de los clientes. Debe coincidir con el alias de /uploads/ en la config de nginx.
UPLOADS_DIR="/var/www/mentor-studio-uploads"
