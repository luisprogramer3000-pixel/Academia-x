// Prisma Schema — Virtual Language School in a Box (Mentor Studio Global)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum AcademyRole {
  OWNER
  TEACHER
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  COURSE
  STANDALONE_LESSON
}

enum AICreditType {
  TEACHER
  STUDENT
}

enum AICreditTransactionType {
  ALLOCATION
  USAGE
  PURCHASE
  BONUS
  ROLLOVER
  REFUND
  ADJUSTMENT
  EXPIRATION
}

enum AIOperation {
  COURSE_GENERATION
  LESSON_GENERATION
  ACTIVITY_GENERATION
  QUIZ_GENERATION
  LANDING_GENERATION
  LESSON_REGENERATION
  COURSE_REGENERATION
  AI_TUTOR
  AI_FEEDBACK
  CLASS_AGENT
  IMAGE_GENERATION
  IMAGE_GENERATION_HQ
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  avatarUrl    String?
  globalRole   GlobalRole @default(USER)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  memberships          Membership[]
  submissions          Submission[]
  aiUsages             AIUsage[]
  aiCreditTransactions AICreditTransaction[]
  auditLogs            AuditLog[]
  certificates         Certificate[]
  notifications        Notification[]
  aiCreditPurchases    AICreditPurchase[]
  passwordResetTokens  PasswordResetToken[]
  quizAttempts         QuizAttempt[]
  teachingResources    TeachingResource[]
  scheduledClasses     ScheduledClass[]
  liveSessions         LiveSession[]
  progress             Progress[]
  payments             Payment[]
}

/// Tokens de un solo uso para restablecer contraseña (se guarda solo el hash SHA-256)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tenant {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  customDomain     String?  @unique
  logoUrl          String?
  primaryColor     String   @default("#3B82F6")
  secondaryColor   String   @default("#F1F5F9")
  language         String   @default("es")
  /// Zona horaria IANA de la academia: fechas que se muestran desde el servidor
  /// (solicitudes, facturación, certificados, analíticas por mes)
  timezone         String   @default("America/Guayaquil")
  /// Color de fondo del panel del profesor (null = oscuro, el de siempre)
  panelColor       String?
  /// Página pública de la academia: { template, headline, subheadline, callToAction, heroImageUrl }
  landing          Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  memberships          Membership[]
  courses              Course[]
  certificates         Certificate[]
  subscriptions        Subscription[]
  aiUsages             AIUsage[]
  aiCreditWallet       AICreditWallet?
  aiCreditTransactions AICreditTransaction[]
  auditLogs            AuditLog[]
  invitations          Invitation[]
  notifications        Notification[]
  aiCreditPurchases    AICreditPurchase[]
  quizAttempts         QuizAttempt[]
  teachingResources    TeachingResource[]
  scheduledClasses     ScheduledClass[]
  liveSessions         LiveSession[]
  enrollmentRequests   EnrollmentRequest[]
  payments             Payment[]
  paymentCard          PaymentCard?
  photoDecks           PhotoDeck[]
}

model Membership {
  id        String      @id @default(cuid())
  userId    String
  tenantId  String
  role      AcademyRole @default(STUDENT)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

model Course {
  id                  String       @id @default(cuid())
  tenantId            String
  title               String
  slug                String
  description         String?
  language            String       @default("es")
  level               String       @default("A1")
  contentType         ContentType  @default(COURSE)
  status              CourseStatus @default(DRAFT)
  priceAmount         Decimal      @default(0.00)
  currency            String       @default("USD")
  paymentType         String       @default("EXTERNAL")
  paymentLink         String?
  /// Instrucciones de pago para el alumno (datos de transferencia, PayPal...), en cursos de pago
  paymentInstructions String?
  /// La primera lección se muestra gratis en la página pública del curso, como muestra
  freePreview         Boolean      @default(true)
  /// Papelera: con fecha, el curso está borrado (oculto en toda la plataforma) y se
  /// puede restaurar durante 30 días; después se elimina definitivamente.
  deletedAt           DateTime?    @db.Timestamptz(3)
  /// Plantilla de certificado que usará este curso: CLASSIC | MODERN | ELEGANT
  certificateTemplate String       @default("CLASSIC")
  /// Landing de venta generada con IA: { headline, subheadline, benefits[], callToAction }
  landing             Json?
  imageUrl            String?
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules            Module[]
  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  certificates       Certificate[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  order       Int      @default(0)
  content     String? // JSON string block data
  liveUrl     String?
  /// Plan del profesor (NO visible para el alumno): objetivo, guion de tiempos,
  /// requisitos previos, tarea y notas didácticas que genera el Agente de Clase.
  teacherPlan Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignments  Assignment[]
  progresses   Progress[]
  quizAttempts QuizAttempt[]

  @@index([moduleId, order])
}

/// Intento de quiz de un alumno en una lección. La corrección se hace SIEMPRE
/// en el servidor: el navegador nunca recibe las respuestas correctas.
model QuizAttempt {
  id             String   @id @default(cuid())
  tenantId       String
  lessonId       String
  userId         String
  score          Int // 0-100
  correctCount   Int
  totalQuestions Int
  answers        Json // [{ blockId, selected, correct }]
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, lessonId])
  @@index([userId])
  @@index([lessonId, userId])
}

/// Biblioteca "Mis recursos": planes de clase y materiales generados por el
/// profesorado. Se comparte con todo el staff de la academia.
model TeachingResource {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  /// CLASS_PLAN
  kind      String    @default("CLASS_PLAN")
  title     String
  subject   String?
  grade     String?
  topic     String?
  /// Contenido completo (ClassPlanOutput para CLASS_PLAN)
  data      Json
  /// Lección del campus creada a partir de este recurso, si se convirtió
  lessonId  String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  /// Papelera: con fecha, el recurso está borrado y se puede restaurar durante 30 días
  deletedAt DateTime? @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules ScheduledClass[]

  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

/// Clase programada en el calendario del profesor.
model ScheduledClass {
  id              String               @id @default(cuid())
  tenantId        String
  userId          String
  resourceId      String?
  title           String
  startsAt        DateTime             @db.Timestamptz(3)
  durationMinutes Int                  @default(50)
  groupName       String?
  notes           String?
  /// Programada, dada o cancelada
  status          ScheduledClassStatus @default(SCHEDULED)
  /// Enlace de la reunión online (Zoom, Meet, Teams...), solo https
  meetingUrl      String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource TeachingResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
}

enum ScheduledClassStatus {
  SCHEDULED
  DONE
  CANCELLED
}

/// Quiz en vivo: el profesor proyecta, los alumnos responden desde el móvil
/// con un código (sin cuenta). Las respuestas correctas viven solo en servidor.
model LiveSession {
  id                String    @id @default(cuid())
  tenantId          String
  hostUserId        String
  resourceId        String?
  code              String    @unique
  title             String
  /// [{ prompt, options[], correctIndex, explanation }]
  questions         Json
  /// LOBBY | QUESTION | REVEAL | ENDED
  status            String    @default("LOBBY")
  currentIndex      Int       @default(-1)
  questionStartedAt DateTime? @db.Timestamptz(3)
  timeLimitSec      Int       @default(20)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  endedAt           DateTime? @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host         User              @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  participants LiveParticipant[]
  answers      LiveAnswer[]

  @@index([tenantId, createdAt])
}

model LiveParticipant {
  id        String   @id @default(cuid())
  sessionId String
  nickname  String
  /// SHA-256 del token que guarda el navegador del alumno
  tokenHash String
  score     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  session LiveSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers LiveAnswer[]

  @@unique([sessionId, nickname])
  @@index([sessionId, score])
}

model LiveAnswer {
  id            String   @id @default(cuid())
  sessionId     String
  participantId String
  questionIndex Int
  selected      Int
  correct       Boolean
  points        Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  session     LiveSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant LiveParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionIndex])
  @@index([sessionId, questionIndex])
}

model Enrollment {
  id           String   @id @default(cuid())
  membershipId String
  courseId     String
  enrolledAt   DateTime @default(now()) @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([membershipId, courseId])
  @@index([courseId])
}

enum EnrollmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Solicitud de un alumno para entrar en un curso de pago: el profesor la aprueba al confirmar el pago
model EnrollmentRequest {
  id               String                  @id @default(cuid())
  tenantId         String
  courseId         String
  membershipId     String
  status           EnrollmentRequestStatus @default(PENDING)
  /// Comprobante de pago subido por el alumno (/api/uploads/payment-proofs/...)
  proofUrl         String?
  /// Mensaje del alumno al profesor (p. ej. número de transferencia)
  message          String?
  /// Motivo del rechazo, visible para el alumno
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?               @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, courseId])
  @@index([tenantId, status])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// Si se borra el usuario, su progreso se borra con él (antes quedaba huérfano)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Assignment {
  id          String    @id @default(cuid())
  lessonId    String
  title       String
  description String
  /// Fecha límite de entrega que fija el profesor (opcional)
  dueDate     DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([lessonId])
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  content      String
  fileUrl      String?
  grade        String?
  feedback     String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([userId])
}

model Certificate {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  courseId       String
  code           String   @unique
  cryptoHash     String?
  /// Plantilla con la que se emitió (se congela: cambiar el curso no altera los ya emitidos)
  template       String   @default("CLASSIC")
  /// Profesor que aprobó la emisión
  issuedByUserId String?
  issuedAt       DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt])
  @@index([userId])
  @@index([courseId])
}

model AIUsage {
  id                  String   @id @default(cuid())
  tenantId            String
  userId              String
  feature             String
  provider            String
  model               String
  promptTokens        Int
  completionTokens    Int
  estimatedCost       Decimal  @default(0.0000)
  creditsUsed         Int      @default(0)
  creditTransactionId String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditTransaction AICreditTransaction? @relation(fields: [creditTransactionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model AICreditWallet {
  id                             String   @id @default(cuid())
  tenantId                       String   @unique
  teacherCredits                 Int      @default(0)
  studentCredits                 Int      @default(0)
  monthlyTeacherAllowance        Int      @default(0)
  monthlyStudentAllowance        Int      @default(0)
  rolloverTeacherCredits         Int      @default(0)
  rolloverStudentCredits         Int      @default(0)
  purchasedTeacherCredits        Int      @default(0)
  purchasedStudentCredits        Int      @default(0)
  allowTeacherCreditsForStudents Boolean  @default(false)
  resetAt                        DateTime @db.Timestamptz(3)
  createdAt                      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AICreditTransaction {
  id              String                  @id @default(cuid())
  tenantId        String
  userId          String?
  creditType      AICreditType
  amount          Int
  transactionType AICreditTransactionType
  operation       AIOperation
  referenceId     String?
  idempotencyKey  String?                 @unique
  metadata        Json?
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiUsages AIUsage[]

  @@index([tenantId, createdAt])
  @@index([referenceId])
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

/// Plan de la academia. Con Payphone no hay suscripción en el proveedor: el
/// sistema extiende currentPeriodEnd con cada pago aprobado y, si hay tarjeta
/// guardada y autoRenew, la cobra solo al vencer (cron subscription-renewals).
/// externalId: "pp_<tenantId>" (Payphone), "sub_internal_<tenantId>" (cortesía)
/// o "sub_simulated_<tenantId>" (desarrollo sin Payphone).
model Subscription {
  id                   String          @id @default(cuid())
  tenantId             String
  externalId           String?         @unique
  planId               String
  billingInterval      BillingInterval @default(MONTHLY)
  status               String
  currentPeriodEnd     DateTime        @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean         @default(false)
  /// Cobrar sola la tarjeta guardada al vencer (si la academia tiene una)
  autoRenew            Boolean         @default(true)
  /// Intentos de cobro automático fallidos en el periodo actual
  renewalAttempts      Int             @default(0)
  lastRenewalAttemptAt DateTime?       @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, updatedAt])
}

/// Cobro hecho con Payphone: plan (SUBSCRIPTION) o paquete de créditos (TOPUP).
/// clientTransactionId es nuestro identificador ante Payphone (único, 15 caracteres);
/// payphoneTransactionId, el suyo, que llega al volver del formulario de pago.
model Payment {
  id                    String          @id @default(cuid())
  tenantId              String
  userId                String?
  kind                  String          // SUBSCRIPTION | TOPUP
  /// BUTTON: el cliente pagó en el formulario de Payphone; TOKEN: cobro automático de la tarjeta guardada
  method                String          @default("BUTTON")
  status                String          @default("PENDING") // PENDING | APPROVED | CANCELED | FAILED
  planId                String?
  billingInterval       BillingInterval?
  topupPurchaseId       String?         @unique
  amountCents           Int
  taxCents              Int             @default(0)
  currency              String          @default("USD")
  clientTransactionId   String          @unique
  payphoneTransactionId Int?            @unique
  authorizationCode     String?
  cardBrand             String?
  lastDigits            String?
  /// El cliente aceptó guardar la tarjeta para cobros automáticos
  saveCard              Boolean         @default(false)
  failureReason         String?
  confirmedAt           DateTime?       @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

/// Tarjeta tokenizada por Payphone para cobros automáticos (una por academia).
/// El token y los datos del titular se guardan cifrados (src/lib/secret-box.ts).
model PaymentCard {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  /// cardToken de Payphone (ctoken), cifrado
  tokenEncrypted  String
  /// { name, email, phoneNumber, document } del titular, cifrado
  holderEncrypted String
  cardBrand       String?
  lastDigits      String?
  /// Momento en que el cliente aceptó los cobros automáticos
  consentAt       DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Invitation {
  id        String      @id @default(cuid())
  tenantId  String
  email     String
  role      AcademyRole @default(STUDENT)
  token     String      @unique
  expiresAt DateTime    @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  details   String? // JSON string
  ipAddress String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId])
}

enum NotificationType {
  CREDIT_WARNING
  CREDIT_LOW
  CREDIT_CRITICAL
  CREDIT_EXHAUSTED
  CREDIT_REFUNDED
  CREDIT_MONTHLY_RESET
  CREDIT_TOPUP_PURCHASED
  CREDIT_TOPUP_FAILED
  CREDIT_TOPUP_REFUNDED
  ENROLLMENT_REQUEST
  SUBSCRIPTION_RENEWAL_REMINDER
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PAYMENT_FAILED
}

model Notification {
  id             String           @id @default(cuid())
  tenantId       String
  userId         String?
  type           NotificationType
  creditType     AICreditType?
  title          String
  message        String
  read           Boolean          @default(false)
  idempotencyKey String?          @unique
  metadata       Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, read])
  @@index([tenantId, createdAt])
}

model AICreditPurchase {
  id                String       @id @default(cuid())
  tenantId          String
  userId            String?
  packageId         String
  creditType        AICreditType
  creditsGranted    Int
  priceAmount       Decimal      @db.Decimal(10, 2)
  currency          String       @default("USD")
  status            String       @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  provider          String       @default("mock")
  providerPaymentId String?      @unique
  idempotencyKey    String?      @unique
  metadata          Json?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

/// Presentación "foto + texto": la IA escribe el guion, el profesor lo revisa y
/// después se genera una foto por diapositiva (cada una se puede regenerar sola).
/// script = { title, slides: [{ id, type, title, text, items[], imagePrompt,
///   photo: "realistic" | "economic", notes, imageUrl?, imageStatus? }] }
model PhotoDeck {
  id        String   @id @default(cuid())
  tenantId  String
  lessonId  String
  userId    String?
  title     String
  /// SCRIPT (en revisión) | READY (con fotos)
  status    String   @default("SCRIPT")
  script    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, lessonId, updatedAt])
}
