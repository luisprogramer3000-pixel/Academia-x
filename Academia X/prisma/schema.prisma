// Prisma Schema — Virtual Language School in a Box (Academia X)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum AcademyRole {
  OWNER
  TEACHER
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AICreditType {
  TEACHER
  STUDENT
}

enum AICreditTransactionType {
  ALLOCATION
  USAGE
  PURCHASE
  BONUS
  ROLLOVER
  REFUND
  ADJUSTMENT
  EXPIRATION
}

enum AIOperation {
  COURSE_GENERATION
  LESSON_GENERATION
  ACTIVITY_GENERATION
  QUIZ_GENERATION
  LANDING_GENERATION
  LESSON_REGENERATION
  COURSE_REGENERATION
  AI_TUTOR
  AI_FEEDBACK
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  passwordHash         String?
  avatarUrl            String?
  globalRole           GlobalRole            @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  memberships          Membership[]
  submissions          Submission[]
  aiUsages             AIUsage[]
  aiCreditTransactions AICreditTransaction[]
  auditLogs            AuditLog[]
  certificates         Certificate[]
  notifications        Notification[]
  aiCreditPurchases    AICreditPurchase[]
  passwordResetTokens  PasswordResetToken[]
}

/// Tokens de un solo uso para restablecer contraseña (se guarda solo el hash SHA-256)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  customDomain         String?               @unique
  stripeCustomerId     String?               @unique
  logoUrl              String?
  primaryColor         String                @default("#3B82F6")
  secondaryColor       String                @default("#1E293B")
  language             String                @default("es")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  memberships          Membership[]
  courses              Course[]
  certificates         Certificate[]
  subscriptions        Subscription[]
  aiUsages             AIUsage[]
  aiCreditWallet       AICreditWallet?
  aiCreditTransactions AICreditTransaction[]
  auditLogs            AuditLog[]
  invitations          Invitation[]
  notifications        Notification[]
  aiCreditPurchases    AICreditPurchase[]
}

model Membership {
  id        String      @id @default(cuid())
  userId    String
  tenantId  String
  role      AcademyRole @default(STUDENT)
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Course {
  id          String       @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  description String?
  language    String       @default("es")
  level       String       @default("A1")
  status      CourseStatus @default(DRAFT)
  priceAmount Decimal      @default(0.00)
  currency    String       @default("USD")
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules     Module[]
  enrollments Enrollment[]
  certificates Certificate[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  order       Int      @default(0)
  content     String?  // JSON string block data
  createdAt   DateTime @default(now())

  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  progresses  Progress[]
}

model Enrollment {
  id           String     @id @default(cuid())
  membershipId String
  courseId     String
  enrolledAt   DateTime   @default(now())

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([membershipId, courseId])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Assignment {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  description String
  createdAt   DateTime @default(now())

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  content      String
  grade        String?
  feedback     String?
  createdAt    DateTime   @default(now())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certificate {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  courseId       String
  code           String   @unique
  issuedAt       DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AIUsage {
  id                  String               @id @default(cuid())
  tenantId            String
  userId              String
  feature             String
  provider            String
  model               String
  promptTokens        Int
  completionTokens    Int
  estimatedCost       Decimal              @default(0.0000)
  creditsUsed         Int                  @default(0)
  creditTransactionId String?
  createdAt           DateTime             @default(now())

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditTransaction   AICreditTransaction? @relation(fields: [creditTransactionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model AICreditWallet {
  id                             String   @id @default(cuid())
  tenantId                       String   @unique
  teacherCredits                 Int      @default(0)
  studentCredits                 Int      @default(0)
  monthlyTeacherAllowance        Int      @default(0)
  monthlyStudentAllowance        Int      @default(0)
  rolloverTeacherCredits         Int      @default(0)
  rolloverStudentCredits         Int      @default(0)
  purchasedTeacherCredits        Int      @default(0)
  purchasedStudentCredits        Int      @default(0)
  allowTeacherCreditsForStudents Boolean  @default(false)
  resetAt                        DateTime
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  tenant                         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AICreditTransaction {
  id              String                  @id @default(cuid())
  tenantId        String
  userId          String?
  creditType      AICreditType
  amount          Int
  transactionType AICreditTransactionType
  operation       AIOperation
  referenceId     String?
  idempotencyKey  String?                 @unique
  metadata        Json?
  createdAt       DateTime                @default(now())

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  aiUsages        AIUsage[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([referenceId])
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Subscription {
  id                   String          @id @default(cuid())
  tenantId             String
  stripeCustomerId     String?
  stripeSubscriptionId String?         @unique
  stripePriceId        String?
  planId               String
  billingInterval      BillingInterval @default(MONTHLY)
  status               String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt

  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Registro de eventos de Stripe ya procesados (idempotencia de webhooks)
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Invitation {
  id        String      @id @default(cuid())
  tenantId  String
  email     String
  role      AcademyRole @default(STUDENT)
  token     String      @unique
  expiresAt DateTime
  createdAt DateTime    @default(now())

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  details   String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  CREDIT_WARNING
  CREDIT_LOW
  CREDIT_CRITICAL
  CREDIT_EXHAUSTED
  CREDIT_REFUNDED
  CREDIT_MONTHLY_RESET
  CREDIT_TOPUP_PURCHASED
  CREDIT_TOPUP_FAILED
  CREDIT_TOPUP_REFUNDED
}

model Notification {
  id             String           @id @default(cuid())
  tenantId       String
  userId         String?
  type           NotificationType
  creditType     AICreditType?
  title          String
  message        String
  read           Boolean          @default(false)
  idempotencyKey String?          @unique
  metadata       Json?
  createdAt      DateTime         @default(now())

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, read])
  @@index([tenantId, createdAt])
}

model AICreditPurchase {
  id                String            @id @default(cuid())
  tenantId          String
  userId            String?
  packageId         String
  creditType        AICreditType
  creditsGranted    Int
  priceAmount       Decimal           @db.Decimal(10, 2)
  currency          String            @default("USD")
  status            String            @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  provider          String            @default("mock")
  providerPaymentId String?           @unique
  idempotencyKey    String?           @unique
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
}


